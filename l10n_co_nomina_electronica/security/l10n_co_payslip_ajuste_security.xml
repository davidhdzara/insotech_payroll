<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E11 pieza 2b (.288): la visibilidad del ajuste es la del recibo al que pertenece. Global por compañía; el oficial y el administrador de nómina ven todo
         (v19, P6-3: hr_payroll_rule_officer y hr_payslip_rule_manager son [(1,'=',1)], enterprise/hr_payroll/security/hr_payroll_security.xml:37-49). -->
    <record id="rule_l10n_co_payslip_ajuste_company" model="ir.rule">
        <field name="name">Ajuste de recibo: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_payslip_ajuste"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_payslip_ajuste_oficial" model="ir.rule">
        <field name="name">Ajuste de recibo: el oficial de nómina ve todo, como en el recibo (hr_payroll_rule_officer)</field>
        <field name="model_id" ref="model_l10n_co_payslip_ajuste"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_l10n_co_payslip_ajuste_administrador" model="ir.rule">
        <field name="name">Ajuste de recibo: el administrador de nómina ve todo</field>
        <field name="model_id" ref="model_l10n_co_payslip_ajuste"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
