<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aislamiento multiempresa de los modelos propios con company_id (doc 51, M4 paso 2).
         Mismo patron que hr_payroll para recibo/linea/lote: reglas globales
         company_id in company_ids. La configuracion de retencion admite ademas filas
         compartidas (company_id vacio, M2). -->
    <record id="rule_l10n_co_retefuente_uvt_company" model="ir.rule">
        <field name="name">Configuración de retención: compañías autorizadas y compartidas</field>
        <field name="model_id" ref="model_l10n_co_retefuente_uvt"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_retefuente_procedure2_company" model="ir.rule">
        <field name="name">Retención Procedimiento 2: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_retefuente_procedure2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_ibc_mensual_company" model="ir.rule">
        <field name="name">IBC mensual: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_ibc_mensual"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_nomina_ugpp_company" model="ir.rule">
        <field name="name">UGPP: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_nomina_ugpp"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_pila_planilla_company" model="ir.rule">
        <field name="name">Planillas PILA: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_pila_planilla"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_payslip_tercero_company" model="ir.rule">
        <field name="name">Distribución por tercero: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_payslip_tercero"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_ne_operation_mode_company" model="ir.rule">
        <field name="name">Modo de operación de nómina electrónica: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_ne_operation_mode"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- v19 (pieza P6-3, orden de TL 2026-11-22): la visibilidad de estos modelos es la del recibo NATIVO de v19. La regla nativa del oficial es
         `hr_payroll_rule_officer` = [(1,'=',1)] (enterprise/hr_payroll/security/hr_payroll_security.xml:37-42, «Payroll officier should have access to all
         payslips») y la del administrador `hr_payslip_rule_manager` = [(1,'=',1)] (:44-49). Aquí el oficial y el administrador ven todo dentro de las
         compañías permitidas: solo se conserva la regla global multicompañía (company_id in company_ids), que se combina con Y con las reglas de grupo.
         En v18 el oficial se limitaba por usuario, departamento y jefe del departamento; esa restricción NO existe en v19. -->
    <record id="rule_l10n_co_ibc_mensual_oficial" model="ir.rule">
        <field name="name">IBC mensual: el oficial de nómina ve todo, como en el recibo (hr_payroll_rule_officer)</field>
        <field name="model_id" ref="model_l10n_co_ibc_mensual"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_l10n_co_ibc_mensual_administrador" model="ir.rule">
        <field name="name">IBC mensual: el administrador de nómina ve todo</field>
        <field name="model_id" ref="model_l10n_co_ibc_mensual"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_l10n_co_payslip_tercero_oficial" model="ir.rule">
        <field name="name">Distribución por tercero: el oficial de nómina ve todo, como en el recibo (hr_payroll_rule_officer)</field>
        <field name="model_id" ref="model_l10n_co_payslip_tercero"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_l10n_co_payslip_tercero_administrador" model="ir.rule">
        <field name="name">Distribución por tercero: el administrador de nómina ve todo</field>
        <field name="model_id" ref="model_l10n_co_payslip_tercero"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
