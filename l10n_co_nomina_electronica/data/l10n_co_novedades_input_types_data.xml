        <!--
            Tipos de input de TODAS las novedades manuales de la estructura de nómina colombiana.

            Cada regla salarial lee su novedad con inputs['CO_XXX'].amount, pero solo existían los
            tipos de horas extra y embargos: sin hr.payslip.input.type el código no existe y RRHH
            no puede registrar la novedad (ni por pantalla ni por ORM). Quedaban sin forma de
            capturarse: vacaciones, prima, cesantías, intereses, incapacidades, licencias,
            bonificaciones, comisiones, auxilios, viáticos y las deducciones manuales (libranza,
            sindicato, cooperativa, AFC, pensión voluntaria, plan complementario, educación...).
            Hallazgo de QA en la Ronda 1 DIAN (2026-10-05): bloqueaba cualquier nómina real con
            esas novedades, no solo las pruebas. Mismo patrón que l10n_co_horas_extra_input_types_data.xml.

            Unidad de cada entrada (la que lee su regla): "(días)" = cantidad de días, el resto = valor en pesos.
        -->

        <record id="input_co_afc" model="hr.payslip.input.type">
            <field name="name">AFC - Ahorro Fomento Construcción</field>
            <field name="code">CO_AFC</field>
            <field name="country_id" ref="base.co"/>
        </record>

