<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- v19 (decisión de TL, 2026-11-22): los crons del módulo se instalan INACTIVOS (``active`` = False) y dentro de ``noupdate="1"``. Una instalación nueva no envía
             nada a la DIAN, y menos la habilitación, hasta que el administrador del sistema los active (Ajustes > Técnico > Acciones planificadas): «sin valores por defecto
             silenciosos». Con ``noupdate`` un ``-u`` posterior NO apaga un cron que un cliente ya activó. LLEVAR A v18 AL FINAL DE LA RUTA, con ``noupdate`` obligatorio (en
             Guapante producción están pausados a mano). -->
        <!-- Avanza la habilitación DIAN automática una etapa por ejecución; el propio método se
             re-programa con ir.cron._trigger mientras queda trabajo. Sin trabajo pendiente no hace nada. -->
        <record id="ir_cron_ne_habilitacion" model="ir.cron">
            <field name="name">Nómina Electrónica: avance de la habilitación DIAN</field>
            <field name="model_id" ref="model_l10n_co_ne_habilitacion"/>
            <field name="state">code</field>
            <field name="code">model._cron_step()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
