<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  FORM VIEW                                                    -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_hr_embargo_form" model="ir.ui.view">
        <field name="name">l10n.co.hr.embargo.form</field>
        <field name="model">l10n.co.hr.embargo</field>
        <field name="arch" type="xml">
            <form string="Embargo Judicial">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Referencia del Proceso"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="employee_id"/>
                            <field name="tipo_embargo"/>
                            <field name="juzgado"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Valores del Descuento">
                            <field name="valor_fijo"/>
                            <field name="porcentaje"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1"
                               placeholder="Notas adicionales sobre el embargo..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  LIST VIEW                                                    -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_hr_embargo_list" model="ir.ui.view">
        <field name="name">l10n.co.hr.embargo.list</field>
        <field name="model">l10n.co.hr.embargo</field>
        <field name="arch" type="xml">
            <list string="Embargos Judiciales">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="tipo_embargo"/>
                <field name="valor_fijo"/>
                <field name="porcentaje"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-muted="state == 'closed'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  SEARCH VIEW                                                  -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_hr_embargo_search" model="ir.ui.view">
        <field name="name">l10n.co.hr.embargo.search</field>
        <field name="model">l10n.co.hr.embargo</field>
        <field name="arch" type="xml">
            <search string="Buscar Embargos">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="juzgado"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_active" string="Activos"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_suspended" string="Suspendidos"
                        domain="[('state', '=', 'suspended')]"/>
                <filter name="filter_closed" string="Cerrados"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_civil" string="Civil"
                        domain="[('tipo_embargo', '=', 'civil')]"/>
                <filter name="filter_alimentos" string="Alimentos"
                        domain="[('tipo_embargo', '=', 'alimentos')]"/>
                <filter name="filter_cooperativa" string="Cooperativa"
                        domain="[('tipo_embargo', '=', 'cooperativa')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_employee" string="Empleado"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Tipo de Embargo"
                            context="{'group_by': 'tipo_embargo'}"/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Compañía"
                            context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  ACTION                                                       -->
    <!-- ============================================================ -->
    <record id="action_l10n_co_hr_embargo" model="ir.actions.act_window">
        <field name="name">Embargos Judiciales</field>
        <field name="res_model">l10n.co.hr.embargo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_co_hr_embargo_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar un nuevo embargo judicial
            </p>
            <p>
                Gestione los embargos judiciales de los empleados con cálculo
                automático de topes legales según el Art. 155 del CST y
                Art. 594 del CPC.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  MENU                                                         -->
    <!-- ============================================================ -->
    <menuitem id="menu_l10n_co_hr_embargo"
              name="Embargos Judiciales"
              action="action_l10n_co_hr_embargo"
              parent="hr_payroll.menu_hr_payroll_employees_root"
              sequence="40"/>

    <!-- ============================================================ -->
    <!--  EMPLOYEE FORM — Embargos Notebook Page                       -->
    <!-- ============================================================ -->
    <record id="view_employee_form_embargo" model="ir.ui.view">
        <field name="name">hr.employee.form.embargo</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Embargos Judiciales" name="embargos">
                    <field name="l10n_co_embargo_ids" nolabel="1"
                           context="{'default_employee_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="tipo_embargo"/>
                            <field name="valor_fijo"/>
                            <field name="porcentaje"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="juzgado"/>
                            <field name="state"
                                   decoration-success="state == 'active'"
                                   decoration-warning="state == 'suspended'"
                                   decoration-muted="state == 'closed'"
                                   widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
