<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- UGPP Report - Form View                                       -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_nomina_ugpp_form" model="ir.ui.view">
        <field name="name">l10n_co_nomina.ugpp.form</field>
        <field name="model">l10n_co_nomina.ugpp</field>
        <field name="arch" type="xml">
            <form string="Reporte UGPP">
                <header>
                    <button name="action_generate_report"
                            string="Generar Reporte"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'generated'"
                            groups="hr_payroll.group_hr_payroll_manager"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year" string="Año"/>
                            <field name="month" string="Mes"/>
                        </group>
                        <group>
                            <field name="date_from" string="Fecha Desde"/>
                            <field name="date_to" string="Fecha Hasta"/>
                            <field name="company_id" string="Compañía"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="state != 'generated'">
                        <field name="excel_file"
                               string="Archivo Excel"
                               filename="excel_filename"/>
                        <field name="excel_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- UGPP Report - Tree View                                       -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_nomina_ugpp_tree" model="ir.ui.view">
        <field name="name">l10n_co_nomina.ugpp.tree</field>
        <field name="model">l10n_co_nomina.ugpp</field>
        <field name="arch" type="xml">
            <list string="Reportes UGPP">
                <field name="name" string="Nombre"/>
                <field name="year" string="Año"/>
                <field name="month" string="Mes"/>
                <field name="state" string="Estado"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- UGPP Report - Search View                                     -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_nomina_ugpp_search" model="ir.ui.view">
        <field name="name">l10n_co_nomina.ugpp.search</field>
        <field name="model">l10n_co_nomina.ugpp</field>
        <field name="arch" type="xml">
            <search string="Buscar Reportes UGPP">
                <field name="name"/>
                <field name="year"/>
                <filter name="filter_current_year"
                        string="Año Actual"
                        domain="[('year', '=', (context_today()).year)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_year"
                            string="Año"
                            context="{'group_by': 'year'}"/>
                    <filter name="group_state"
                            string="Estado"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- UGPP Report - Action                                          -->
    <!-- ============================================================ -->
    <record id="action_l10n_co_nomina_ugpp" model="ir.actions.act_window">
        <field name="name">Reportes UGPP</field>
        <field name="res_model">l10n_co_nomina.ugpp</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_co_nomina_ugpp_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo reporte UGPP
            </p>
            <p>
                Genere reportes para la Unidad de Gestión Pensional y Parafiscales (UGPP)
                con la información de nómina de sus empleados.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Items                                                    -->
    <!-- ============================================================ -->
    <menuitem id="menu_l10n_co_nomina_reportes"
              name="Reportes Colombia"
              parent="hr_payroll.menu_hr_payroll_report"
              sequence="90"/>

    <menuitem id="menu_l10n_co_nomina_ugpp"
              name="Reporte UGPP"
              parent="menu_l10n_co_nomina_reportes"
              action="action_l10n_co_nomina_ugpp"
              sequence="10"
              groups="hr_payroll.group_hr_payroll_manager"/>

</odoo>
