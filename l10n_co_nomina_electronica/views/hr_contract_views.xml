<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contract_form_ne" model="ir.ui.view">
        <field name="name">hr.contract.form.ne</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_form_inherit"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- H12 (2026-11-09, documentador + Tech Lead): contract_details es un grupo EXTERIOR
                 (col="2"); Odoo solo genera la celda de etiqueta para campos dentro de un grupo
                 INTERIOR, así que inyectados directo quedaban sin etiqueta. Se envuelven en su propio
                 <group>, igual que hr_payroll_account en este mismo lugar. -->
            <xpath expr="//group[@name='contract_details']" position="inside">
                <group name="l10n_co_ne_contract_fields" invisible="country_code != 'CO'">
                    <field name="l10n_co_ne_contract_type"
                           string="Tipo Contrato DIAN"/>
                    <field name="l10n_co_ne_integral_salary"
                           string="Salario Integral"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="PILA" name="pila" invisible="country_code != 'CO'">
                    <group string="PILA - Cotización" name="pila_cotizacion">
                        <group>
                            <field name="l10n_co_pila_tipo_cotizante"/>
                            <field name="l10n_co_pila_subtipo_cotizante"/>
                            <field name="l10n_co_pila_salario_variable"/>
                            <field name="l10n_co_pila_clase_riesgo"/>
                        </group>
                        <group>
                            <field name="l10n_co_pila_centro_trabajo"/>
                            <field name="l10n_co_pila_actividad_economica" options="{'no_create': True}"/>
                            <field name="l10n_co_pila_indicador_alto_riesgo"/>
                            <field name="l10n_co_pila_tarifa_especial_afp"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
