<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- v19 (H-V19-14, bloque 2): en Odoo 19 no existe hr.contract ni su formulario; los campos del contrato viven en hr.version y se editan en la ficha del empleado, en la
         pestaña nativa «Nómina» (page[@name='payroll_information'], que hr_payroll reserva a los usuarios de nómina). Grupos propios, sin pestañas nuevas, solo compañías colombianas.
         La ficha edita la versión que muestra (hr/models/hr_employee.py: version_id sale del contexto o es la actual; write manda los campos heredados a la versión). -->
    <record id="view_employee_form_ne_contrato" model="ir.ui.view">
        <field name="name">hr.employee.form.ne.contrato</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']" position="inside">
                <field name="company_country_code" invisible="1"/>
                <!-- H12 (2026-11-09): los campos van DENTRO de un grupo sin subgrupos (grupo interior), el que les genera la celda de la etiqueta. -->
                <group name="l10n_co_ne_contract_fields" string="Contrato DIAN" invisible="company_country_code != 'CO'">
                    <field name="l10n_co_ne_contract_type"
                           string="Tipo Contrato DIAN"/>
                    <field name="l10n_co_ne_integral_salary"
                           string="Salario Integral"/>
                </group>
                <!-- l10n_co_pila_indicador_alto_riesgo NO se muestra en v19 (decisión del TL, 25-nov): duplicaría «Pensión Alto Riesgo» del empleado, que es la que va al XML y a la UGPP. -->
                <group string="PILA - Cotización" name="pila_cotizacion" invisible="company_country_code != 'CO'">
                    <group>
                        <field name="l10n_co_pila_tipo_cotizante"/>
                        <field name="l10n_co_pila_subtipo_cotizante"/>
                        <field name="l10n_co_pila_salario_variable"/>
                        <field name="l10n_co_pila_clase_riesgo"/>
                    </group>
                    <group>
                        <field name="l10n_co_pila_centro_trabajo"/>
                        <field name="l10n_co_pila_actividad_economica" options="{'no_create': True}"/>
                        <field name="l10n_co_pila_tarifa_especial_afp"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- E-9 (H-QA-026), decisión del TL para v19 (opción B): el Salario es MENSUAL en Colombia (CO_BASICO = wage / 30) sin importar «Programar pago». En v19 el rótulo del salario ES el
         selector nativo schedule_pay (hr_payroll lo pone en la misma fila): se conserva intacto (lo leen el aviso de duración, el factor de costos y la periodicidad de la retención) y,
         solo para Colombia, se agrega un texto fijo junto al salario, sin clases ni estilos propios. -->
    <record id="view_employee_form_ne_salario_mes" model="ir.ui.view">
        <field name="name">hr.employee.form.ne.salario.mes</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']//div[@name='wage']" position="inside">
                <field name="company_country_code" invisible="1"/>
                <span name="l10n_co_ne_wage_period_label" invisible="company_country_code != 'CO'">El valor es mensual</span>
            </xpath>
        </field>
    </record>

</odoo>
