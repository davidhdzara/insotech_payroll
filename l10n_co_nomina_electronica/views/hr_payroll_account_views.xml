<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Configuracion Contable: List View (editable bottom)           -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_payroll_account_config_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.account.config.list</field>
        <field name="model">l10n.co.payroll.account.config</field>
        <field name="arch" type="xml">
            <list string="Configuracion Contable de Nomina" editable="bottom">
                <field name="salary_rule_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Configuracion Contable: Form View                             -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_payroll_account_config_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.account.config.form</field>
        <field name="model">l10n.co.payroll.account.config</field>
        <field name="arch" type="xml">
            <form string="Configuracion Contable de Nomina">
                <sheet>
                    <group>
                        <group string="Regla Salarial">
                            <field name="salary_rule_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Cuentas Contables">
                            <field name="debit_account_id"/>
                            <field name="credit_account_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Configuracion Contable: Search View                           -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_payroll_account_config_search" model="ir.ui.view">
        <field name="name">l10n.co.payroll.account.config.search</field>
        <field name="model">l10n.co.payroll.account.config</field>
        <field name="arch" type="xml">
            <search string="Buscar Configuracion Contable">
                <field name="salary_rule_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <filter string="Mi Compania"
                        name="my_company"
                        domain="[('company_id', '=', allowed_company_ids[0])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Compania"
                            name="group_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action: Configuracion Contable de Nomina                      -->
    <!-- ============================================================ -->
    <record id="action_l10n_co_payroll_account_config" model="ir.actions.act_window">
        <field name="name">Cuentas Contables</field>
        <field name="res_model">l10n.co.payroll.account.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurar cuentas contables para la nomina
            </p>
            <p>
                Defina las cuentas de debito y credito para cada regla
                salarial. Al confirmar una nomina, se generara automaticamente
                un asiento contable con las partidas correspondientes.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu: Nomina > Configuracion > Cuentas Contables              -->
    <!-- ============================================================ -->
    <menuitem id="menu_l10n_co_payroll_account_config"
              name="Cuentas Contables"
              parent="menu_l10n_co_nomina_colombia_config"
              action="action_l10n_co_payroll_account_config"
              sequence="40"
              groups="hr_payroll.group_hr_payroll_manager"/>

    <!-- ============================================================ -->
    <!-- Payslip Form: campos contables (inherit)                      -->
    <!-- ============================================================ -->
    <record id="view_payslip_form_account" model="ir.ui.view">
        <field name="name">hr.payslip.form.account</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <!-- Agregar campos contables en la pestaña de informacion -->
            <xpath expr="//notebook" position="inside">
                <page string="Contabilidad" name="accounting">
                    <group>
                        <group string="Configuracion Contable">
                            <field name="journal_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Asiento Generado">
                            <field name="move_id"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
