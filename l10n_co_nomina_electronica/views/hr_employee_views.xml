<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- UX-01 (2026-10-11, decisión de David + Tech Lead): antes esta vista creaba DOS
         pestañas propias ("Nómina Electrónica" y "Nómina Colombia") con datos repetidos
         entre ellas (banco, EPS/AFP/CCF) y una ficha ("Nómina Colombia") que solo
         reempaquetaba visualmente datos que ya viven en el contrato, la compañía o el
         button box nativo. Ahora se complementa la pestaña nativa de Nómina (hr_payroll,
         page[@name='hr_payroll']) en vez de duplicarla: cada campo aparece UNA sola vez
         en todo el formulario. Sin campos nuevos, sin cambios de modelo ni de cálculo/XML. -->
    <record id="view_employee_form_ne" model="ir.ui.view">
        <field name="name">hr.employee.form.ne</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_payroll']" position="inside">
                <field name="company_country_code" invisible="1"/>

                <!-- UX-02 (2026-10-11): el tipo de documento ya no vive aquí, sale del
                     tipo de identificación nativo de Contactos, mostrado junto al número
                     en "Información privada" (ver xpath de identification_id abajo). -->
                <group string="Identificación DIAN" name="dian_identification" invisible="company_country_code != 'CO'">
                    <group>
                        <field name="l10n_co_primer_nombre"/>
                        <field name="l10n_co_otros_nombres"/>
                        <field name="l10n_co_primer_apellido"/>
                        <field name="l10n_co_segundo_apellido"/>
                    </group>
                    <group>
                        <field name="l10n_co_ne_worker_type"
                               string="Tipo Trabajador"/>
                        <field name="l10n_co_ne_worker_subtype"
                               string="Subtipo Trabajador"/>
                    </group>
                    <group>
                        <field name="l10n_co_ne_high_risk_pension"
                               string="Pensión Alto Riesgo"/>
                    </group>
                </group>

                <!-- H-018 (2026-10-11): el municipio DANE del lugar de trabajo ya no
                     vive en un campo propio, sale de la "Dirección de Trabajo" nativa
                     del empleado (address_id). Ver _ne_trabajador() en hr_payslip.py. -->
                <group string="Condiciones Especiales" name="work_location" invisible="company_country_code != 'CO'">
                    <group>
                        <field name="l10n_co_ne_foreigner_no_pension"
                               string="Extranjero sin Pensión en Colombia"/>
                        <field name="l10n_co_ne_colombian_abroad"
                               string="Colombiano en el Exterior"/>
                    </group>
                </group>

                <!-- UX-02 (2026-10-11, precisión de David): Banco/TipoCuenta/
                     NumeroCuenta ya no viven aquí, salen de la Cuenta Bancaria
                     nativa del empleado (bank_account_id, "Información privada" >
                     "Contacto privado"). Este grupo queda solo con el medio de
                     pago, que no tiene equivalente nativo; su ayuda (tooltip)
                     indica dónde se elige la cuenta. -->
                <group string="Datos de Pago" name="payment_data" invisible="company_country_code != 'CO'">
                    <field name="l10n_co_ne_payment_method"
                           string="Medio de Pago"/>
                </group>

                <group string="PILA - Administradoras" name="pila_administradoras" invisible="company_country_code != 'CO'">
                    <group>
                        <field name="l10n_co_pila_eps_id" options="{'no_create': True}"/>
                        <field name="l10n_co_pila_afp_id" options="{'no_create': True}"/>
                        <field name="l10n_co_pila_ccf_por_empleado" invisible="1"/>
                        <field name="l10n_co_pila_ccf_id" options="{'no_create': True}"
                               invisible="not l10n_co_pila_ccf_por_empleado"
                               required="l10n_co_pila_ccf_por_empleado"/>
                    </group>
                    <group>
                        <field name="l10n_co_pila_afp_traslado"/>
                        <field name="l10n_co_pila_eps_traslado"/>
                        <field name="l10n_co_pila_colombiano_exterior"/>
                        <field name="l10n_co_pila_fecha_radicacion_ext"
                               invisible="not l10n_co_pila_colombiano_exterior"/>
                    </group>
                </group>

            </xpath>

            <!-- UX-02 (2026-10-11, precisión de David): el tipo de documento va justo
                 ENCIMA del número, en la misma pestaña nativa donde ya vive
                 identification_id (page[@name='personal_information'], grupo
                 "Citizenship"), editable ahí, sin repetirse en ninguna otra pestaña. -->
            <xpath expr="//page[@name='personal_information']//field[@name='identification_id']"
                   position="before">
                <field name="l10n_co_ne_identification_type_id" string="Tipo de Documento"
                       invisible="company_country_code != 'CO'"/>
            </xpath>
        </field>
    </record>

</odoo>
