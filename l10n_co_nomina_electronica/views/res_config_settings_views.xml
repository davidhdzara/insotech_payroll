<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_co_nomina_electronica</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Localización nómina (.99, pedido de David): primer bloque de la
                 app, calcado del bloque "Fiscal Localization" de Accounting
                 (chart_template/reload_template, verificado contra el código
                 real de account 18.0). hr_payroll no tiene un framework de
                 plantillas equivalente: este bloque calca el patrón VISUAL,
                 no reusa un mecanismo nativo de Nómina que no existe. -->
            <block id="hr_payroll_accountant" position="before">
                <block title="Localización nómina" id="l10n_co_ne_settings_localizacion"
                       invisible="not is_root_company or company_country_code != 'CO'">
                    <setting string="Localización nómina" company_dependent="1"
                             help="Reglas salariales, parámetros legales y nómina electrónica de su país">
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="l10n_co_ne_payroll_package" string="Paquete" class="col-2 o_light_label"/>
                                    <field name="l10n_co_ne_payroll_package"
                                           readonly="l10n_co_ne_has_payroll_entries"
                                           required="l10n_co_ne_payroll_package"/>
                                </div>
                                <div class="mt16">
                                    <field name="l10n_co_ne_has_payroll_entries" invisible="1"/>
                                    <button name="action_reload_payroll_package" type="object" string="Recargar"
                                            class="btn-secondary ps-2 w-100"
                                            invisible="not l10n_co_ne_has_payroll_entries or not l10n_co_ne_payroll_package"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
            <!-- hr_payroll ya oculta su propio setting "Payroll Rules" (el
                 botón "Choose a Payroll Localization") cuando fr/be/in están
                 instalados, para no duplicar con su propio bloque de
                 localización: mismo criterio, agregamos nuestra condición
                 con OR (XML real confirmado por Tech Lead contra el servidor,
                 enterprise/hr_payroll/views/res_config_settings_views.xml).

                 Odoo 18 prohíbe usar el atributo "string" como selector de
                 herencia de vistas ("View inheritance may not use attribute
                 'string' as a selector", reproducido por Tech Lead en el
                 servidor): se ancla en el div id="localization_text" del
                 botón nativo (el único id real y estable que existe ahí) y
                 se sube al <setting> ancestro. -->
            <xpath expr="//div[@id='localization_text']/ancestor::setting"
                   position="attributes">
                <attribute name="invisible">module_l10n_fr_hr_payroll or module_l10n_be_hr_payroll or module_l10n_in_hr_payroll or l10n_co_ne_payroll_package</attribute>
            </xpath>
            <block id="hr_payroll_settings" position="after">
                <field name="company_country_code" invisible="1"/>
                <t invisible="company_country_code != 'CO'">
                    <block title="Nómina Electrónica DIAN" id="l10n_co_ne_settings_dian">
                        <setting class="w-100" help="Configura el Software ID/PIN asignados por la DIAN para nómina electrónica en el portal de habilitación. Nómina Individual y Nota de Ajuste comparten siempre el mismo modo de operación.">
                            <field name="l10n_co_ne_operation_mode_ids" class="w-100" string="Modos de Operación"/>
                        </setting>
                        <setting class="col-lg-12" help="Marque esta casilla si está probando flujos de nómina electrónica o si necesita activar el entorno de proceso de certificación.">
                            <field name="l10n_co_ne_test_environment"/>
                        </setting>
                        <setting class="col-lg-12" invisible="l10n_co_ne_test_environment" help="Active este modo para poder probar los flujos de nómina electrónica solo con validaciones internas, pero sin respuesta del entorno de la DIAN.">
                            <field name="l10n_co_ne_demo_mode"/>
                        </setting>
                        <setting class="col-lg-12" invisible="not l10n_co_ne_test_environment" help="Envía documentos de prueba de nómina electrónica con su certificado para lograr el estado 'Habilitado' en el portal de la DIAN.">
                            <field name="l10n_co_ne_certification_process"/>
                        </setting>
                        <setting string="Habilitación DIAN" invisible="not l10n_co_ne_certification_process" help="Metas de documentos que deben quedar Aceptados por la DIAN, y asistente para prepararlos y enviarlos usando el pipeline real de nómina.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="l10n_co_ne_num_nomina_certificar" class="col-lg-5 o_light_label" string="Meta Nómina Individual"/>
                                    <field name="l10n_co_ne_num_nomina_certificar"/>
                                </div>
                                <div class="row mt8">
                                    <label for="l10n_co_ne_num_ajuste_certificar" class="col-lg-5 o_light_label" string="Meta Nota de Ajuste"/>
                                    <field name="l10n_co_ne_num_ajuste_certificar"/>
                                </div>
                                <div class="row mt8">
                                    <button type="object" name="action_iniciar_habilitacion_nomina" string="Iniciar Proceso de Habilitación" class="btn-link" confirm="Se prepararán, enviarán y consultarán en la DIAN los documentos de habilitación, de forma automática. Consume cupo real del ID de Pruebas. ¿Continuar?"/>
                                </div>
                                <div class="row mt8" invisible="l10n_co_ne_hab_state == 'idle'">
                                    <field name="l10n_co_ne_hab_progress" widget="progressbar" nolabel="1" class="col-lg-5"/>
                                    <button type="object" name="action_refresh_habilitacion" string="Actualizar" class="btn-link col-lg-2"/>
                                </div>
                                <div class="row mt8" invisible="l10n_co_ne_hab_state == 'idle'">
                                    <field name="l10n_co_ne_hab_summary" nolabel="1" readonly="1"/>
                                </div>
                                <div class="row mt8" invisible="not l10n_co_ne_hab_message">
                                    <field name="l10n_co_ne_hab_state" invisible="1"/>
                                    <field name="l10n_co_ne_hab_message" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Consecutivos" help="Prefijos y secuencias usadas para los consecutivos de nómina y notas de ajuste.">
                            <field name="l10n_co_ne_payroll_prefix"/>
                            <field name="l10n_co_ne_adjust_prefix"/>
                            <!-- AUD-DIAN-34 (2026-10-04): incidente real en Guapante,
                                 estas 2 secuencias quedaron intercambiadas con la de
                                 Notas de Ajuste (NA) por selección manual equivocada en
                                 la UI. El dominio ya restringe cada selector a su código
                                 exacto, pero se deja explícito en la etiqueta cuál
                                 secuencia es cuál para que no se repita. -->
                            <field name="l10n_co_ne_sequence_id"
                                   string="Secuencia Nómina Electrónica (NE, definitiva)"/>
                            <field name="l10n_co_ne_pre_sequence_id"
                                   string="Secuencia Temporal (PRE-NOM -- NO es la de Notas de Ajuste)"/>
                        </setting>
                    </block>
                    <block title="Certificado Digital" id="l10n_co_ne_settings_certificate">
                        <setting class="w-100" help="Agregue sus certificados para firmar los documentos de nómina electrónica (XAdES-BES). Es la misma lista de certificados que usa facturación electrónica -- no requiere uno independiente. Nómina usa siempre el último certificado de la lista, igual que Facturación Electrónica.">
                            <field name="l10n_co_ne_certificate_ids" class="w-100" string="Certificados"/>
                        </setting>
                    </block>
                    <block title="Cuentas Predeterminadas" id="l10n_co_ne_settings_accounts">
                        <setting string="Diarios Contables por Estructura Salarial" help="Diario donde el motor contable nativo de Odoo (hr_payroll_account) registra el asiento al confirmar cada tipo de nómina.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="l10n_co_ne_journal_nomina_id" class="col-lg-5 o_light_label" string="Nómina General"/>
                                    <field name="l10n_co_ne_journal_nomina_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="l10n_co_ne_journal_prima_id" class="col-lg-5 o_light_label" string="Prima de Servicios"/>
                                    <field name="l10n_co_ne_journal_prima_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="l10n_co_ne_journal_liquidacion_id" class="col-lg-5 o_light_label" string="Liquidación de Contrato"/>
                                    <field name="l10n_co_ne_journal_liquidacion_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="l10n_co_ne_journal_bonificacion_id" class="col-lg-5 o_light_label" string="Bonificaciones Extraordinarias"/>
                                    <field name="l10n_co_ne_journal_bonificacion_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Cuentas Contables por Regla Salarial" help="52+ reglas salariales, cada una con su cuenta de débito/crédito -- se administran en su propia pantalla, no caben como campos individuales aquí (mismo criterio que Contabilidad con su plan de cuentas completo).">
                            <button type="action" name="%(l10n_co_nomina_electronica.action_hr_salary_rule_account_ne)d" string="Abrir Cuentas Contables" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="UGPP" id="l10n_co_ne_settings_ugpp">
                        <setting help="Clasificación del aportante ante la UGPP.">
                            <field name="l10n_co_ugpp_legal_nature"/>
                            <field name="l10n_co_ugpp_contributor_type"/>
                        </setting>
                        <setting string="Autorretención Especial" help="Indica si la empresa tiene la calidad de autorretenedor especial ante la UGPP.">
                            <field name="l10n_co_ugpp_special_autoretention"/>
                        </setting>
                    </block>
                    <block title="Parámetros Nómina Colombia" id="l10n_co_ne_settings_params">
                        <setting help="Exoneración de aportes a SENA/ICBF para empleados con salario inferior a 10 SMMLV (Art. 114-1 ET, Ley 1607/2012).">
                            <field name="l10n_co_ne_exoneration_1607"/>
                        </setting>
                        <setting help="En días de suspensión o licencia no remunerada la pensión patronal es opcional en el sector privado (Concepto Min. Protección Social 134658, CST art. 53).">
                            <field name="l10n_co_ne_pension_patronal_sln"/>
                        </setting>
                        <setting string="Febrero en prestaciones" help="Cómo se cuentan los días de febrero en prima, cesantías, intereses, indemnización y vacaciones de la liquidación. No afecta el sueldo mensual ni los días de PILA.">
                            <field name="l10n_co_ne_febrero_modo"/>
                        </setting>
                        <setting string="Redondeo de días del XML" help="Cómo se redondea un número de días fraccionario en los campos de días del XML de nómina electrónica (la DIAN exige enteros). Mismo método de redondeo nativo de Odoo.">
                            <field name="l10n_co_ne_redondeo_dias"/>
                        </setting>
                        <setting string="Medio de Pago" help="Medio de pago de la nómina de la empresa. Un empleado puede tener otro propio (pestaña Nómina Colombia del empleado).">
                            <field name="l10n_co_ne_payment_method"/>
                        </setting>
                        <setting>
                            <div class="text-muted" id="l10n_co_ne_annual_params_text">
                                Los valores de SMMLV, auxilio de transporte y UVT se configuran
                                por año en <a type="action" name="%(hr_payroll.hr_rule_parameter_action)d">Nómina › Configuración › Parámetros Anuales</a>.
                            </div>
                        </setting>
                    </block>
                    <block title="PILA" id="l10n_co_ne_settings_pila">
                        <setting string="Tipo Aportante PILA" help="Tipo de aportante según la tabla de la Planilla Integrada de Liquidación de Aportes (Empleador, Independiente, Entidad Promotora de Salud, etc.).">
                            <field name="l10n_co_pila_tipo_aportante"/>
                        </setting>
                        <setting string="ARL" help="Contacto de la ARL a la que está afiliada la empresa. El código PILA (ej: 14-11) se toma del contacto.">
                            <field name="l10n_co_pila_arl_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Caja de Compensación" help="Si la empresa tiene empleados en diferentes ciudades, active la casilla y elija la caja en cada empleado; si no, elija aquí la caja de toda la empresa.">
                            <field name="l10n_co_pila_ccf_por_empleado"/>
                            <field name="l10n_co_pila_ccf_id" options="{'no_create': True}"
                                   invisible="l10n_co_pila_ccf_por_empleado"/>
                        </setting>
                        <setting string="Clase de Riesgo ARL" help="Clase de riesgo de la empresa. Un contrato puede tener otra propia (pestaña PILA del contrato).">
                            <field name="l10n_co_pila_clase_riesgo"/>
                        </setting>
                        <setting string="Centro de Trabajo ARL" help="Código del centro de trabajo ARL de la empresa. Un contrato puede tener otro propio (pestaña PILA del contrato).">
                            <field name="l10n_co_pila_centro_trabajo"/>
                        </setting>
                        <setting string="SENA" help="Contacto al que se causa el aporte parafiscal al SENA.">
                            <field name="l10n_co_sena_partner_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="ICBF" help="Contacto al que se causa el aporte parafiscal al ICBF.">
                            <field name="l10n_co_icbf_partner_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="DIAN" help="Contacto de la DIAN, tercero de la retención en la fuente.">
                            <field name="l10n_co_dian_partner_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Forma Presentación PILA" help="Forma de presentación de la planilla ante el operador: Único (un solo pago consolidado) o Sucursal (aportante que declara por sucursales separadas).">
                            <field name="l10n_co_pila_forma_presentacion"/>
                        </setting>
                        <setting string="Código Sucursal PILA" help="Código de la sucursal reportado en la planilla. Solo aplica si Forma Presentación PILA es 'Sucursal'.">
                            <field name="l10n_co_pila_codigo_sucursal"/>
                        </setting>
                        <setting string="Nombre Sucursal PILA" help="Nombre de la sucursal reportado en la planilla. Solo aplica si Forma Presentación PILA es 'Sucursal'.">
                            <field name="l10n_co_pila_nombre_sucursal"/>
                        </setting>
                        <setting string="Código Operador PILA" help="Código del operador de información ante el cual se presenta la planilla (ej: 89 para Enlace).">
                            <field name="l10n_co_pila_operador_code"/>
                        </setting>
                    </block>
                </t>
            </block>
        </field>
    </record>

</odoo>
