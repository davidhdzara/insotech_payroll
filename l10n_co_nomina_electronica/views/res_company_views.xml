<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_ne" model="ir.ui.view">
        <field name="name">res.company.form.ne</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nómina Electrónica DIAN" name="nomina_electronica_dian">

                    <group string="Configuración Software DIAN" name="dian_software_config">
                        <group>
                            <field name="l10n_co_ne_software_id"
                                   string="ID Software"/>
                            <field name="l10n_co_ne_software_pin"
                                   string="PIN Software"
                                   password="True"/>
                            <field name="l10n_co_ne_test_set_id"
                                   string="Test Set ID"/>
                        </group>
                        <group>
                            <field name="l10n_co_ne_environment"
                                   string="Ambiente"
                                   widget="radio"/>
                            <field name="l10n_co_ne_payroll_prefix"
                                   string="Prefijo Nómina"/>
                            <field name="l10n_co_ne_adjust_prefix"
                                   string="Prefijo Nota de Ajuste"/>
                            <field name="l10n_co_ne_sequence_id"
                                   string="Secuencia Nómina"/>
                            <field name="l10n_co_ne_pre_sequence_id"
                                   string="Secuencia Temporal"/>
                        </group>
                    </group>

                    <group string="Certificado Digital" name="digital_certificate">
                        <field name="l10n_co_ne_certificate_id"/>
                    </group>

                    <group string="Configuración UGPP" name="ugpp_config">
                        <group>
                            <field name="l10n_co_ugpp_legal_nature"
                                   string="Naturaleza Jurídica"/>
                            <field name="l10n_co_ugpp_contributor_type"
                                   string="Tipo de Aportante"/>
                        </group>
                        <group>
                            <field name="l10n_co_ugpp_special_autoretention"
                                   string="Autorretención Especial"/>
                        </group>
                    </group>

                    <group string="Parámetros Nómina Colombia" name="payroll_params">
                        <group>
                            <field name="l10n_co_ne_exoneration_1607"
                                   string="Exoneración Ley 1607/2012"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Los valores de SMMLV, auxilio de transporte y UVT
                                se configuran por año en
                                Nómina &gt; Configuración &gt; Parámetros Anuales.
                            </div>
                        </group>
                    </group>

                    <group string="PILA - Configuración" name="pila_config">
                        <group>
                            <field name="l10n_co_pila_tipo_aportante"/>
                            <field name="l10n_co_pila_arl_code"/>
                            <field name="l10n_co_pila_forma_presentacion"/>
                        </group>
                        <group>
                            <field name="l10n_co_pila_codigo_sucursal"/>
                            <field name="l10n_co_pila_nombre_sucursal"/>
                            <field name="l10n_co_pila_operador_code"/>
                        </group>
                    </group>

                </page>
            </xpath>
        </field>
    </record>

</odoo>
