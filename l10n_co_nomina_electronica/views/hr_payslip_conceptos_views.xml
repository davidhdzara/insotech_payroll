<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E11 pieza 3 (.289, doc 71c §5): pestaña «Conceptos de pago» del recibo. Solo para las estructuras con el interruptor
         l10n_co_ne_conceptos_de_pago; en las demás las pestañas nativas quedan igual. v19 (decisión 3 de TL, 2026-11-21): v18 ocultaba UNA página
         `worked_days_input`; v19 trae dos (hr_payroll/views/hr_payslip_views.xml:176 `worked_days`, con name y con su propio `invisible`, y :193 «Salary Inputs»,
         sin name): se ocultan por `//page[@name='worked_days']` (conservando la condición nativa `not use_worked_day_lines`) y por
         `//field[@name='input_line_ids']/ancestor::page`, y la pestaña nueva va después de la de novedades. Selectores por @name o por el campo que
         contiene la página (nunca por @string), sin colores ni íconos propios. Lista one2many ESTÁNDAR (decisión de TL, 2026-11-22, para v19: el widget section_and_note_one2many del módulo account pinta en cada
         fila de sección un menú —Add a line, Add a note, Move Up/Down, Duplicate y Delete, estos dos sobre la sección completa— que no se puede ocultar; v18 conserva el
         widget). Las secciones salen en negrita con decoration-bf (atributo nativo de la lista, no un color) y las notas en cursiva con decoration-it; las columnas de valor
         se ocultan por fila con invisible="display_type" (lo que el widget hacía solo); sequence sin el widget handle (con él la lista estándar deja arrastrar cualquier fila,
         incluidas las secciones: parte de vista de .300b). SOLO «Agregar concepto» (control/create, sin «Agregar sección» ni «Agregar nota»). La papelera sale también en las
         filas de sección y su error («Las secciones no se pueden borrar.») llega al guardar. decoration-bf en la lista de v19: NO verificado (lo dirán la prueba de vista y la carga). -->
    <record id="view_payslip_form_ne_conceptos" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne.conceptos</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='worked_days']" position="attributes">
                <attribute name="invisible">not use_worked_day_lines or l10n_co_ne_usa_conceptos</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/ancestor::page" position="attributes">
                <attribute name="invisible">l10n_co_ne_usa_conceptos</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/ancestor::page" position="after">
                <page string="Conceptos de pago" name="conceptos_de_pago" invisible="not l10n_co_ne_usa_conceptos">
                    <field name="l10n_co_ne_usa_conceptos" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_dias">
                        <strong>Revise las entradas de trabajo</strong><br/>
                        <field name="l10n_co_ne_aviso_dias" readonly="1" nolabel="1"/>
                    </div>
                    <!-- .301 (doc 76 §2.2): mismo patrón nativo que el aviso de las entradas de trabajo; solo avisa, no bloquea ni cambia el cálculo. -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_no_salarial">
                        <strong>Revise los pagos no salariales</strong><br/>
                        <field name="l10n_co_ne_aviso_no_salarial" readonly="1" nolabel="1"/>
                    </div>
                    <!-- .302 (doc 76 §2.3): siempre avisa el pacto que falta (aunque el interruptor de exigirlo al confirmar esté en 0). -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_pacto">
                        <strong>Falta el pacto de desalarización o su soporte</strong><br/>
                        <field name="l10n_co_ne_aviso_pacto" readonly="1" nolabel="1"/>
                    </div>
                    <field name="l10n_co_concepto_ids" nolabel="1" mode="list" readonly="state != 'draft'">
                        <list editable="bottom" decoration-bf="display_type == 'line_section'" decoration-it="display_type == 'line_note'">
                            <control>
                                <create name="add_concepto_control" string="Agregar concepto"/>
                            </control>
                            <!-- Como en la lista nativa de novedades (hr_payroll/views/hr_payslip_views.xml:172): el cliente debe enviar el recibo en el
                                 onchange de una fila nueva para calcular qué se puede editar. -->
                            <field name="slip_id" column_invisible="True" required="0"/>
                            <field name="sequence" column_invisible="True"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="origen" column_invisible="True"/>
                            <field name="ajustado" column_invisible="True"/>
                            <field name="edita_cantidad" column_invisible="True"/>
                            <field name="edita_porcentaje" column_invisible="True"/>
                            <field name="edita_importe" column_invisible="True"/>
                            <field name="name" readonly="origen in ('calculado', 'dias')"/>
                            <!-- .297/.298: en las filas calculadas el tipo sale vacío, pero en «Agregar concepto» es OBLIGATORIO y ahí se elige: columna OPCIONAL visible por
                                 defecto, el patrón nativo de las listas de Ventas (``optional="show"``; .297 la dejó en ``hide`` y el usuario no veía dónde elegirlo). -->
                            <field name="input_type_id" optional="show" readonly="id" invisible="display_type" options="{'no_create': True, 'no_open': True}"/>
                            <field name="quantity" readonly="not edita_cantidad" invisible="display_type"/>
                            <field name="unidad" readonly="1" invisible="display_type"/>
                            <!-- .297: el % se muestra SOLO si es distinto de 100 y con 2 decimales (la misma regla de la colilla). Atributo nativo ``digits`` del campo
                                 (``web/static/src/views/fields/float/float_field.js:133-139``); ``invisible`` por fila, como ``amount`` y ``total``. -->
                            <field name="rate" digits="[16, 2]" readonly="not edita_porcentaje" invisible="display_type or origen == 'dias' or rate == 100"/>
                            <field name="amount" readonly="not edita_importe" invisible="display_type or origen == 'dias'"/>
                            <field name="total" readonly="1" invisible="display_type or origen == 'dias'"/>
                        </list>
                    </field>
                    <group col="12">
                        <group colspan="7" name="conceptos_observaciones">
                            <field name="note" nolabel="1" placeholder="Observaciones..." readonly="state != 'draft'"/>
                        </group>
                        <group class="oe_subtotal_footer" colspan="5" name="conceptos_totales">
                            <field name="l10n_co_total_devengado"/>
                            <field name="l10n_co_total_deducciones"/>
                            <field name="net_wage" string="Neto a pagar" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
