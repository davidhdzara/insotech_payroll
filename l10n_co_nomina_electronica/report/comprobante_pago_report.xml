<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         Comprobante de pago ÚNICO por empleado y fecha de pago (Frente 5, C3).

         Comprobante INTERNO: sin QR, CUNE ni referencias a la DIAN. Genérico y multicliente: logo, colores y fuente del
         diseño de documentos de la compañía (``web.external_layout``), solo clases nativas de Bootstrap, importes con la
         moneda de la compañía, cada media página con el nombre de la estructura salarial del recibo. Reutiliza el encabezado
         y la tabla compacta de la colilla (E11 pieza 5b, .292: una media página por recibo del grupo).

         Media hoja A4 horizontal (A5, 210 x 148 mm) con un formato de papel PROPIO del informe: no cambia el formato de
         papel de la compañía ni el de otros informes.
         =================================================================== -->
    <!-- El formato de papel ``paperformat_comprobante_pago`` (A5 horizontal) se define en ``hr_payslip_ne_report.xml``: lo comparten la colilla
         por recibo y este comprobante (E11 pieza 5a: la colilla también es de media página). -->

    <record id="action_report_comprobante_pago" model="ir.actions.report">
        <field name="name">Comprobante de pago por fecha de pago</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_nomina_electronica.report_comprobante_pago</field>
        <field name="report_file">l10n_co_nomina_electronica.report_comprobante_pago</field>
        <field name="paperformat_id" ref="paperformat_comprobante_pago"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <!-- E11 pieza 5b (.292): UNA media página por RECIBO del grupo (cada recibo llama a su propio ``web.external_layout``), con el encabezado y la
         tabla compacta de la colilla por recibo (``ne_comprobante_encabezado`` y ``ne_colilla_tabla``). Quincena + prima del mismo día = dos medias
         páginas; el «Neto total pagado» del grupo va en la ÚLTIMA y solo si el grupo tiene más de un recibo. Cada media página lleva el nombre de la
         estructura salarial del recibo (doc 58 D5-5). -->
    <template id="report_comprobante_pago">
        <t t-call="web.html_container">
            <t t-foreach="grupos" t-as="g">
                <t t-set="moneda" t-value="g['moneda']"/>
                <t t-set="dias_pagados" t-value="g['dias_pagados']"/>
                <t t-set="fecha_pago" t-value="g['fecha_pago']"/>
                <t t-foreach="g['secciones']" t-as="s">
                    <t t-set="o" t-value="s['recibo']"/>
                    <t t-call="web.external_layout">
                        <div class="page">
                            <t t-call="l10n_co_nomina_electronica.ne_comprobante_encabezado"/>
                            <p class="small fw-bold mb-1">
                                <span t-out="o.struct_id.name"/>
                            </p>
                            <t t-call="l10n_co_nomina_electronica.ne_colilla_tabla">
                                <t t-set="colilla" t-value="s['colilla']"/>
                            </t>
                            <table t-if="s_last and g['varios']" class="table table-sm table-bordered small mt-1 mb-0">
                                <tr class="table-light fw-bold">
                                    <td>Neto total pagado</td>
                                    <td class="text-end">
                                        <span t-out="g['neto_total']" t-options='{"widget": "monetary", "display_currency": moneda}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
