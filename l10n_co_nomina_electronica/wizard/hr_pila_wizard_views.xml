<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- PILA Wizard - Form View                                       -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_hr_pila_wizard_form" model="ir.ui.view">
        <field name="name">l10n.co.hr.pila.wizard.form</field>
        <field name="model">l10n.co.hr.pila.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Archivo Plano PILA">
                <group invisible="state == 'done'">
                    <group>
                        <field name="year" string="Año"/>
                        <field name="month" string="Mes"/>
                        <field name="tipo_planilla"/>
                    </group>
                    <group>
                        <field name="company_id"
                               string="Compañía"
                               groups="base.group_multi_company"/>
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <strong>Archivo generado exitosamente.</strong>
                        Haga clic en el botón de descarga para obtener
                        el archivo TXT listo para cargar en su operador PILA.
                    </div>
                    <group>
                        <field name="file_data"
                               filename="file_name"
                               string="Archivo PILA"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_generate_pila"
                            string="Generar Archivo PILA"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PILA Wizard - Action                                          -->
    <!-- ============================================================ -->
    <record id="action_l10n_co_hr_pila_wizard" model="ir.actions.act_window">
        <field name="name">Generar Archivo PILA</field>
        <field name="res_model">l10n.co.hr.pila.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!-- PILA - Menu Item                                              -->
    <!-- ============================================================ -->
    <menuitem id="menu_l10n_co_hr_pila_wizard"
              name="Generar PILA"
              parent="menu_l10n_co_nomina_reportes"
              action="action_l10n_co_hr_pila_wizard"
              sequence="20"/>

</odoo>
