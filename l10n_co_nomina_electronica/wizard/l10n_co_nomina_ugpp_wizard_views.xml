<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_co_nomina_ugpp_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co_nomina.ugpp.wizard.form</field>
        <field name="model">l10n_co_nomina.ugpp.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte UGPP">
                <group>
                    <group>
                        <field name="year" string="Año"/>
                    </group>
                    <group>
                        <field name="month" string="Mes"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate"
                            string="Generar Reporte"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_co_nomina_ugpp_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte UGPP</field>
        <field name="res_model">l10n_co_nomina.ugpp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
