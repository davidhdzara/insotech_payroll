<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_registrar_pago_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.registrar.pago.form</field>
        <field name="model">hr.payslip.registrar.pago</field>
        <field name="arch" type="xml">
            <form string="Registrar fecha de pago">
                <group>
                    <field name="fecha"/>
                    <field name="payslip_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button string="Registrar fecha de pago" name="action_registrar_pago" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Descartar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payslip_registrar_pago" model="ir.actions.act_window">
        <field name="name">Registrar fecha de pago</field>
        <field name="res_model">hr.payslip.registrar.pago</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">form,list</field>
        <field name="groups_id" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
