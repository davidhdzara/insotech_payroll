<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Provision Wizard - Form View                                  -->
    <!-- ============================================================ -->
    <record id="view_l10n_co_hr_provision_wizard_form" model="ir.ui.view">
        <field name="name">l10n.co.hr.provision.wizard.form</field>
        <field name="model">l10n.co.hr.provision.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Provisión de Prestaciones">
                <group>
                    <group>
                        <field name="year" string="Año"/>
                        <field name="month" string="Mes"/>
                    </group>
                    <group>
                        <field name="company_id"
                               string="Compañía"
                               groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_provision"
                            string="Generar Provisión"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Provision Wizard - Action                                     -->
    <!-- ============================================================ -->
    <record id="action_l10n_co_hr_provision_wizard" model="ir.actions.act_window">
        <field name="name">Generar Provisión</field>
        <field name="res_model">l10n.co.hr.provision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item moved here from hr_provision_views.xml to avoid forward reference -->
    <menuitem id="menu_l10n_co_nomina_provisiones_wizard"
              name="Generar Provisión"
              parent="menu_l10n_co_nomina_provisiones_root"
              action="action_l10n_co_hr_provision_wizard"
              sequence="20"
              groups="hr_payroll.group_hr_payroll_manager"/>

</odoo>
