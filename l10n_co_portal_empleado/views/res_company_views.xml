<odoo>
    <record id="view_company_form_portal_employee" model="ir.ui.view">
        <field name="name">res.company.form.portal.employee</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Portal de empleados" groups="hr.group_hr_manager">
                    <separator string="Firmante de certificados laborales" colspan="2"/>
                    <field name="l10n_co_portal_certificate_signatory_employee_id"
                           domain="[('company_id', '=', id), ('active', '=', True)]"/>
                    <field name="l10n_co_portal_certificate_signatory_signature" widget="image"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
