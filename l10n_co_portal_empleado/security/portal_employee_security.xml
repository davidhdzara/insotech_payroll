<odoo>
    <record id="portal_employee_update_request_rule_own" model="ir.rule">
        <field name="name">Portal: solo solicitudes propias</field>
        <field name="model_id" ref="model_l10n_co_portal_employee_update_request"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('requesting_user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="portal_employee_update_request_rule_hr_company" model="ir.rule">
        <field name="name">RRHH: solicitudes de sus compañías</field>
        <field name="model_id" ref="model_l10n_co_portal_employee_update_request"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
